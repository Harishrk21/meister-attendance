PORT=4000
HOST=0.0.0.0

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://attendance:change-me@127.0.0.1:3306/attendance_platform

# Signs access tokens issued by this service. Use a long random value in production.
JWT_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_TTL=12h

# Comma-separated browser origins allowed to call the API (the SPA and any embedding dashboards)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5190

# Audience every SSO ticket must be minted for
SSO_AUDIENCE=attendance-platform

# Public address of the web app; invite links point here
APP_URL=http://localhost:5173

# Used by `npm run seed` to create the HMS Enterprises tenant's SSO config for local testing
SEED_SSO_ISSUER=hms-dashboard
SEED_SSO_SECRET=dev-only-shared-secret-change-me
