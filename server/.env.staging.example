# Copy into Render → meister-attendance-api → Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=10000

DATABASE_URL=mysql://USER:PASSWORD@YOUR_RDS_HOST:3306/attendance_platform
JWT_SECRET=replace-with-at-least-32-random-characters-for-staging
ACCESS_TOKEN_TTL=12h
SSO_AUDIENCE=attendance-platform

# Include HMS live web + this Attendance web (+ local for hybrid tests)
CORS_ORIGINS=https://novacrms.vercel.app,https://meister-attendance.vercel.app,http://localhost:5190,http://localhost:5173
APP_URL=https://meister-attendance.vercel.app

# Optional one-time seed only
# SEED_SSO_ISSUER=hms-dashboard
# SEED_SSO_SECRET=generate-a-staging-shared-secret
