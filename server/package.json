{
  "name": "attendance-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:local": "node --env-file-if-exists=.env dist/index.js",
    "build:render": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "migrate": "tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:ci": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "seed": "tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/seed.ts",
    "sso:ticket": "tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/mint-sso-ticket.ts",
    "platform:admin": "tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/create-platform-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
